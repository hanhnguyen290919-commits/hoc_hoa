          <div id="progressPercent" class="text-lg md:text-xl font-bold text-amber-800">0%</div>
        </div>
      </div>

      <!-- Controls -->
      <div class="flex items-center gap-2">
        <!-- Sound Toggle -->
        <button id="soundToggleBtn" onclick="toggleAudio()" class="bg-amber-200 hover:bg-amber-300 text-amber-900 p-2.5 rounded-xl border-2 border-amber-500 font-bold text-sm flex items-center gap-1 transition">
          <span id="soundIcon">🔊</span>
