    </div>
  </main>

  <!-- Footer -->
  <footer class="text-center py-3 text-emerald-950 font-semibold text-xs md:text-sm z-10 bg-emerald-600/30">
    🌱 Trò chơi tương tác học tập Hóa Học 12 - Ôn tập Lipid, Chất béo & Acid béo
  </footer>

  <!-- Question Modal Overlay -->
  <div id="questionModal" class="fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center p-3 z-50 hidden opacity-0 transition-opacity duration-300">
    <div class="wood-panel w-full max-w-2xl rounded-3xl p-5 md:p-6 relative max-h-[92vh] overflow-y-auto transform scale-95 transition-transform duration-300" id="modalContainer">
      
      <!-- Close / Back Button -->
      <button onclick="closeQuestionModal()" class="absolute top-4 right-4 bg-amber-200 hover:bg-amber-300 text-amber-950 rounded-full w-9 h-9 flex items-center justify-center font-bold text-lg border-2 border-amber-800 shadow">
        ✕
      </button>

      <!-- Modal Header -->
      <div class="flex items-center gap-3 mb-4 pb-3 border-b-2 border-amber-400">
        <div id="modalCropIcon" class="text-4xl p-2 bg-amber-200 rounded-2xl border-2 border-amber-600">
          🥕
        </div>
        <div>
          <span id="modalCropName" class="text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-200 px-2.5 py-1 rounded-full border border-amber-400">
            Cà rốt #1
          </span>
          <h2 id="modalTitle" class="text-lg md:text-xl font-bold text-amber-950 mt-1">Câu hỏi Lipid</h2>
        </div>
      </div>

      <!-- Question Text -->
      <div class="bg-amber-50 p-4 rounded-2xl border-2 border-amber-300 mb-4 shadow-inner">
        <p id="modalQuestionText" class="text-base md:text-lg text-amber-950 font-semibold leading-relaxed">
          Nội dung câu hỏi...
        </p>
      </div>

      <!-- 4 Option Buttons -->
      <div id="optionsContainer" class="grid grid-cols-1 gap-2.5 mb-4">
        <!-- Buttons added by JS -->
      </div>

      <!-- Feedback / SGK Explanation Box -->
      <div id="feedbackBox" class="hidden p-4 rounded-2xl border-2 mb-4 transition-all">
        <div id="feedbackTitle" class="font-bold text-base md:text-lg mb-1 flex items-center gap-2">
          <!-- Dynamically set -->
        </div>
        <div id="feedbackExplanation" class="text-sm md:text-base leading-relaxed text-slate-800">
          <!-- Explanation text -->
        </div>
      </div>

      <!-- Modal Actions -->
      <div class="flex justify-end gap-3 pt-2">
        <button id="retryBtn" onclick="retryQuestion()" class="hidden bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2.5 rounded-xl border-2 border-amber-800 shadow transition">
          🔄 Thử lại
        </button>
        <button id="nextBtn" onclick="closeQuestionModal()" class="hidden bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-2.5 rounded-xl border-2 border-emerald-900 shadow transition flex items-center gap-2">
          <span>Thu hoạch & Tiếp tục</span> 🌾
        </button>
      </div>

    </div>
  </div>

  <!-- Victory Screen Modal -->
  <div id="victoryModal" class="fixed inset-0 bg-black/75 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden">
    <div class="wood-panel w-full max-w-lg rounded-3xl p-6 text-center relative animate-bounce-short">
      
      <div class="text-6xl md:text-7xl mb-2 animate-pulse">🏆</div>
      <h2 class="text-2xl md:text-3xl font-black text-amber-900 mb-1">XUẤT SẮC THU HOẠCH!</h2>
      <p class="text-emerald-800 font-bold text-lg mb-4">Danh hiệu: NÔNG DÂN GIỎI HÓA HỌC 🎓🌾</p>

      <div class="bg-amber-50 rounded-2xl p-4 border-2 border-amber-300 mb-6 text-left space-y-2">
        <div class="flex justify-between items-center text-amber-900 font-bold">
          <span>⭐ Tổng điểm đạt được:</span>
          <span id="finalScore" class="text-2xl text-amber-600">1500</span>
        </div>
        <div class="flex justify-between items-center text-amber-900 font-bold">
          <span>🧺 Cây đã thu hoạch:</span>
          <span class="text-xl text-emerald-600">15 / 15</span>
        </div>
        <div class="flex justify-between items-center text-amber-900 font-bold">
          <span>🎯 Độ chính xác:</span>
          <span id="accuracyText" class="text-xl text-blue-600">100%</span>
        </div>
        <p id="encouragingMsg" class="text-xs md:text-sm text-slate-700 pt-2 border-t border-amber-200 italic">
          Bạn đã nắm vững toàn bộ kiến thức SGK Lipid, Chất Béo & Acid Béo Hóa Học 12!
        </p>
      </div>

      <button onclick="resetGame()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-lg font-extrabold py-3.5 rounded-2xl border-4 border-emerald-900 shadow-xl transition transform active:scale-95">
        🌱 VÀO MÙA VỤ MỚI (CHƠI LẠI)
      </button>
    </div>
  </div>

  <!-- Info Modal -->
  <div id="infoModal" class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden">
    <div class="wood-panel w-full max-w-md rounded-3xl p-6 relative">
      <button onclick="closeInfoModal()" class="absolute top-4 right-4 bg-amber-200 hover:bg-amber-300 text-amber-950 rounded-full w-8 h-8 font-bold">✕</button>
      <h3 class="text-xl font-bold text-amber-950 mb-3 flex items-center gap-2">
        <span>📖</span> Hướng Dẫn Trò Chơi
      </h3>
      <div class="text-sm text-slate-800 space-y-2.5 leading-relaxed bg-amber-50 p-4 rounded-xl border border-amber-300">
        <p>1. **Bấm vào từng cây rau củ** trên luống đất để mở câu hỏi ôn tập Lipid SGK Hóa 12.</p>
        <p>2. **Trả lời đúng**: Bạn sẽ thu hoạch nông sản, nhận +100 điểm và tích lũy số lượng cây.</p>
        <p>3. **Trả lời chưa đúng**: Trò chơi hiển thị lời giải thích chi tiết từ SGK Hóa 12 để bạn học lại và chọn lại.</p>
        <p>4. **Thu hoạch đủ 15 cây** để mở khóa danh hiệu **Nông Dân Giỏi Hóa Học**!</p>
      </div>
      <button onclick="closeInfoModal()" class="mt-4 w-full bg-amber-700 text-white py-2.5 rounded-xl font-bold">Đã Rõ!</button>
    </div>
  </div>

  <!-- Confetti Canvas -->
  <canvas id="confettiCanvas"></canvas>

  <script>
    // 15 Questions based on SGK Chemistry 12 (Lipid - Fat - Fatty Acids)
    const questionsData = [
      {
        id: 1,
        cropName: "Cà rốt",
        cropIcon: "🥕",
        question: "Lipid là gì theo định nghĩa trong Sách giáo khoa Hóa học 12?",
        options: [
          "Hợp chất vô cơ dễ tan trong nước tạo dung dịch keo.",
          "Hợp chất hữu cơ có trong tế bào sống, không tan trong nước nhưng tan trong dung môi hữu cơ không phân cực.",
          "Hợp chất hữu cơ chỉ gồm các loại ester đơn chức mạch carbon ngắn.",
          "Polymer thiên nhiên chứa các nguyên tố carbon, hydrogen, oxygen và nitrogen."
        ],
        correct: 1,
        explanation: "SGK định nghĩa: Lipid là các hợp chất hữu cơ có trong tế bào sống, không tan trong nước nhưng tan trong các dung môi hữu cơ không phân cực (như ether, chloroform, benzene...)."
      },
      {
        id: 2,
        cropName: "Cà chua",
        cropIcon: "🍅",
        question: "Chất béo (triglyceride) thuộc loại hợp chất nào sau đây?",
        options: [
          "Monoester của glycerol với acid béo.",
          "Triester của glycerol với acid béo.",
          "Diester của ethylene glycol với acid béo.",
          "Hợp chất vô cơ phức tạp của lipid."
        ],
        correct: 1,
        explanation: "Chất béo là triester (ester ba chức) của glycerol với acid béo, gọi chung là triglyceride hay triacylglycerol."
      },
      {
        id: 3,
        cropName: "Ngô (Bắp)",
        cropIcon: "🌽",
        question: "Công thức phân tử / cấu tạo thu gọn của Palmitic acid là gì?",
        options: [
          "C17H35COOH (hoặc CH3[CH2]16COOH)",
          "C15H31COOH (hoặc CH3[CH2]14COOH)",
          "C17H33COOH (hoặc CH3[CH2]7CH=CH[CH2]7COOH)",
          "C17H31COOH"
        ],
        correct: 1,
        explanation: "Palmitic acid có công thức cấu tạo thu gọn là CH3[CH2]14COOH (viết gọn là C15H31COOH), đây là một acid béo no."
      },
      {
        id: 4,
        cropName: "Bắp cải",
        cropIcon: "🥬",
        question: "Oleic acid là một acid béo không no chứa 1 liên kết đôi C=C, có công thức cấu tạo thu gọn là:",
        options: [
          "CH3[CH2]14COOH",
          "CH3[CH2]7CH=CH[CH2]7COOH",
          "CH3[CH2]4CH=CHCH2CH=CH[CH2]7COOH",
          "CH3[CH2]16COOH"
        ],
        correct: 1,
        explanation: "Oleic acid có công thức thu gọn là CH3[CH2]7CH=CH[CH2]7COOH (gọn lại là C17H33COOH), chứa 1 liên kết đôi C=C dạng cis."
      },
      {
        id: 5,
        cropName: "Khoai tây",
        cropIcon: "🥔",
        question: "Acid béo nào sau đây chứa 2 liên kết đôi C=C trong phân tử?",
        options: [
          "Palmitic acid",
          "Stearic acid",
          "Oleic acid",
          "Linoleic acid"
        ],
        correct: 3,
        explanation: "Linoleic acid (C17H31COOH) chứa 2 liên kết đôi C=C trong mạch carbon. Palmitic & Stearic acid là acid béo no, Oleic acid chứa 1 liên kết đôi C=C."
      },
      {
        id: 6,
        cropName: "Củ cải trắng",
        cropIcon: "🧅",
        question: "Ở nhiệt độ thường, chất béo chứa nhiều gốc acid béo no (như mỡ lợn, mỡ bò) tồn tại ở trạng thái nào?",
        options: [
          "Trạng thái khí",
          "Trạng thái lỏng",
          "Trạng thái rắn",
          "Dạng dung dịch tan hoàn toàn"
        ],
        correct: 2,
        explanation: "Khi trong phân tử chất béo chứa nhiều gốc acid béo no (như mỡ lợn, mỡ bò, mỡ cừu) thì chất béo thường ở trạng thái rắn ở nhiệt độ phòng."
      },
