    // Game State
    let currentScore = 0;
    let harvestedCrops = new Array(15).fill(false);
    let currentQuestionIndex = null;
    let attemptsCount = 0;
    let totalAttempts = 0;
    let soundEnabled = true;

    // Web Audio API Sound Generator (No external audio files required!)
    let audioCtx = null;

    function getAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playTone(freq, type, duration, delay = 0) {
      if (!soundEnabled) return;
      try {
        const ctx = getAudioContext();
        setTimeout(() => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, ctx.currentTime);
          gain.gain.setValueAtTime(0.2, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + duration);
        }, delay * 1000);
      } catch (e) {
        console.log('Audio playback prevented');
      }
    }

    function playSuccessSound() {
      playTone(523.25, 'triangle', 0.15, 0);   // C5
      playTone(659.25, 'triangle', 0.15, 0.1); // E5
      playTone(783.99, 'triangle', 0.3, 0.2);  // G5
    }

    function playWrongSound() {
      playTone(220, 'sawtooth', 0.2, 0);     // A3
      playTone(196, 'sawtooth', 0.3, 0.15);  // G3
    }

    function playVictorySound() {
      const notes = [523.25, 659.25, 783.99, 1046.50];
      notes.forEach((freq, idx) => {
        playTone(freq, 'sine', 0.25, idx * 0.12);
      });
    }

    function toggleAudio() {
      soundEnabled = !soundEnabled;
      const soundIcon = document.getElementById('soundIcon');
      soundIcon.textContent = soundEnabled ? "🔊" : "🔇";
    }

    function renderFarmGrid() {
      const grid = document.getElementById('farmGrid');
      grid.innerHTML = '';

      questionsData.forEach((q, index) => {
        const isHarvested = harvestedCrops[index];
        const plot = document.createElement('div');
        
        plot.className = `relative flex flex-col items-center justify-between p-3 md:p-4 rounded-2xl cursor-pointer transition transform hover:-translate-y-1 ${
          isHarvested ? 'soil-plot-harvested border-2 border-amber-900/40' : 'soil-plot border-2 border-amber-700'
        }`;

        plot.onclick = () => openQuestionModal(index);

        plot.innerHTML = `
          <!-- Number Tag -->
          <div class="absolute top-1 left-2 text-[10px] font-black px-1.5 py-0.5 rounded-full ${
            isHarvested ? 'bg-emerald-900 text-emerald-200' : 'bg-amber-900 text-amber-200'
          }">
            #${index + 1}
          </div>

          <!-- Status Indicator -->
          <div class="absolute top-1 right-2 text-xs">
            ${isHarvested ? '🧺' : '🌱'}
          </div>

          <!-- Crop Graphic/Emoji -->
          <div class="my-2 text-4xl md:text-5xl ${isHarvested ? 'opacity-40 filter grayscale' : 'crop-idle'}">
            ${isHarvested ? '🕳️' : q.cropIcon}
          </div>

          <!-- Crop Name Tag -->
          <div class="w-full text-center mt-1">
            <span class="block text-xs md:text-sm font-bold truncate px-1 py-0.5 rounded-lg ${
              isHarvested ? 'bg-emerald-950/60 text-emerald-300' : 'bg-amber-950/70 text-amber-100'
            }">
              ${isHarvested ? 'Đã thu hoạch' : q.cropName}
            </span>
          </div>
        `;

        grid.appendChild(plot);
      });
    }

    function openQuestionModal(index) {
      currentQuestionIndex = index;
      attemptsCount = 0;
      const q = questionsData[index];

      document.getElementById('modalCropIcon').textContent = q.cropIcon;
      document.getElementById('modalCropName').textContent = `${q.cropName} - Cây số ${q.id}`;
      document.getElementById('modalTitle').textContent = `Câu hỏi ôn tập Lipid`;
      document.getElementById('modalQuestionText').textContent = q.question;

      // Render Options
      const optionsContainer = document.getElementById('optionsContainer');
      optionsContainer.innerHTML = '';

      const prefixes = ['A', 'B', 'C', 'D'];
      q.options.forEach((opt, optIdx) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn w-full text-left p-3 md:p-3.5 rounded-xl border-2 border-slate-300 bg-white hover:bg-amber-50 text-slate-800 font-semibold text-sm md:text-base flex items-start gap-3';
        btn.onclick = () => checkAnswer(optIdx);
        btn.id = `optBtn_${optIdx}`;
        btn.innerHTML = `
          <span class="bg-amber-200 text-amber-900 w-7 h-7 rounded-lg font-bold flex items-center justify-center shrink-0 border border-amber-400">
            ${prefixes[optIdx]}
          </span>
          <span class="pt-0.5">${opt}</span>
        `;
        optionsContainer.appendChild(btn);
      });

      // Reset Feedback Box
      const feedbackBox = document.getElementById('feedbackBox');
      feedbackBox.className = 'hidden p-4 rounded-2xl border-2 mb-4';
      document.getElementById('retryBtn').classList.add('hidden');
      document.getElementById('nextBtn').classList.add('hidden');

      // Show Modal
      const modal = document.getElementById('questionModal');
      const container = document.getElementById('modalContainer');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        container.classList.remove('scale-95');
      }, 10);
    }

    function checkAnswer(selectedIndex) {
      totalAttempts++;
      attemptsCount++;
      const q = questionsData[currentQuestionIndex];
      const isCorrect = selectedIndex === q.correct;

      // Disable all option buttons
      const buttons = document.querySelectorAll('#optionsContainer button');
      buttons.forEach(btn => btn.disabled = true);

      const feedbackBox = document.getElementById('feedbackBox');
      const feedbackTitle = document.getElementById('feedbackTitle');
      const feedbackExp = document.getElementById('feedbackExplanation');
      const selectedBtn = document.getElementById(`optBtn_${selectedIndex}`);
      const correctBtn = document.getElementById(`optBtn_${q.correct}`);

      feedbackBox.classList.remove('hidden');

      if (isCorrect) {
        // Success Tone
        playSuccessSound();

        selectedBtn.classList.remove('bg-white', 'border-slate-300');
        selectedBtn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');

        feedbackBox.className = 'p-4 rounded-2xl border-2 mb-4 bg-emerald-50 border-emerald-400 text-emerald-950';
        feedbackTitle.innerHTML = `<span class="text-2xl">🎉</span> Chính xác! Rất giỏi!`;
        feedbackExp.innerHTML = `<b>Giải thích SGK:</b> ${q.explanation}`;

        // Mark harvested if not already
        if (!harvestedCrops[currentQuestionIndex]) {
          harvestedCrops[currentQuestionIndex] = true;
          currentScore += 100;
          showFloatingScore(100);
        }

        updateDashboard();
        renderFarmGrid();

        document.getElementById('nextBtn').classList.remove('hidden');

        // Check for overall victory
        if (harvestedCrops.every(c => c === true)) {
          setTimeout(triggerVictory, 1000);
        }

      } else {
        // Wrong Tone
        playWrongSound();

        selectedBtn.classList.remove('bg-white', 'border-slate-300');
        selectedBtn.classList.add('bg-rose-100', 'border-rose-400', 'text-rose-900');

        // Highlight correct button
        correctBtn.classList.remove('bg-white', 'border-slate-300');
        correctBtn.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');

        feedbackBox.className = 'p-4 rounded-2xl border-2 mb-4 bg-amber-50 border-amber-400 text-amber-950';
        feedbackTitle.innerHTML = `<span class="text-2xl">💡</span> Chưa chính xác! Cùng ôn lại kiến thức nhé:`;
        feedbackExp.innerHTML = `<b>Lời giải SGK Hóa 12:</b> ${q.explanation}`;

        document.getElementById('retryBtn').classList.remove('hidden');
        document.getElementById('nextBtn').classList.remove('hidden');
      }
    }

    function retryQuestion() {
      openQuestionModal(currentQuestionIndex);
    }

    function closeQuestionModal() {
      const modal = document.getElementById('questionModal');
      const container = document.getElementById('modalContainer');
      modal.classList.add('opacity-0');
      container.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    function updateDashboard() {
      const count = harvestedCrops.filter(Boolean).length;
      document.getElementById('scoreDisplay').textContent = currentScore;
      document.getElementById('harvestedCount').textContent = count;
      
      const percent = Math.round((count / 15) * 100);
      document.getElementById('progressPercent').textContent = `${percent}%`;
      document.getElementById('progressBar').style.width = `${percent}%`;
    }

    function showFloatingScore(pts) {
      const el = document.createElement('div');
      el.className = 'floating-score text-2xl md:text-3xl';
      el.textContent = `+${pts} 🧺`;
      el.style.left = `50%`;
      el.style.top = `40%`;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 1200);
    }

    function triggerVictory() {
      playVictorySound();
      startConfetti();

      document.getElementById('finalScore').textContent = currentScore;
      const accuracy = Math.round((15 / Math.max(15, totalAttempts)) * 100);
      document.getElementById('accuracyText').textContent = `${accuracy}%`;

      document.getElementById('victoryModal').classList.remove('hidden');
    }

    function resetGame() {
      currentScore = 0;
      harvestedCrops = new Array(15).fill(false);
      totalAttempts = 0;
      updateDashboard();
      renderFarmGrid();
      document.getElementById('victoryModal').classList.add('hidden');
      stopConfetti();
    }

    function confirmRestart() {
      if (harvestedCrops.some(Boolean)) {
        resetGame();
      } else {
        resetGame();
      }
    }

    function openInfoModal() {
      document.getElementById('infoModal').classList.remove('hidden');
    }

    function closeInfoModal() {
      document.getElementById('infoModal').classList.add('hidden');
    }

    let confettiAnimationId = null;
    function startConfetti() {
      const canvas = document.getElementById('confettiCanvas');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const particles = Array.from({ length: 120 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        color: ['#f43f5e', '#10b981', '#3b82f6', '#f59e0b', '#8b5cf6'][Math.floor(Math.random() * 5)],
        size: Math.random() * 8 + 4,
        speedY: Math.random() * 3 + 2,
        speedX: Math.random() * 2 - 1,
        angle: Math.random() * 360
      }));

      function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach(p => {
          p.y += p.speedY;
          p.x += p.speedX;
          p.angle += 3;
          if (p.y > canvas.height) p.y = -10;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.angle * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
          ctx.restore();
        });
        confettiAnimationId = requestAnimationFrame(render);
      }
      render();
    }

    function stopConfetti() {
      if (confettiAnimationId) {
        cancelAnimationFrame(confettiAnimationId);
      }
      const canvas = document.getElementById('confettiCanvas');
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    // Init on Page Load
    window.onload = function() {
      renderFarmGrid();
      updateDashboard();
