      </div>

    </div>

    <!-- Progress Bar -->
    <div class="w-full bg-amber-950/30 rounded-full h-3 mt-2 overflow-hidden border border-amber-800/40 p-0.5 shadow-inner">
      <div id="progressBar" class="bg-gradient-to-r from-emerald-400 to-green-500 h-full rounded-full transition-all duration-500 w-0"></div>
    </div>
  </header>

  <!-- Main Farm Field -->
  <main class="flex-grow max-w-6xl w-full mx-auto px-3 py-4 z-10">
    
    <!-- Wooden Fence graphic overlay -->
    <div class="w-full h-6 flex justify-between items-end mb-1 opacity-80 px-2">
      <div class="flex gap-2">
        <div class="w-3 h-8 bg-amber-800 border border-amber-950 rounded-t-sm"></div>
        <div class="w-3 h-8 bg-amber-800 border border-amber-950 rounded-t-sm"></div>
        <div class="w-3 h-8 bg-amber-800 border border-amber-950 rounded-t-sm"></div>
      </div>
      <div class="text-2xl">🏡 Nhà Kho Nông Trại</div>
      <div class="flex gap-2">
        <div class="w-3 h-8 bg-amber-800 border border-amber-950 rounded-t-sm"></div>
        <div class="w-3 h-8 bg-amber-800 border border-amber-950 rounded-t-sm"></div>
        <div class="w-3 h-8 bg-amber-800 border border-amber-950 rounded-t-sm"></div>
      </div>
    </div>

    <!-- Soil Plot Grid (15 crops) -->
    <div id="farmGrid" class="grid grid-cols-3 sm:grid-cols-3 md:grid-cols-5 gap-3 md:gap-4 p-4 bg-emerald-800/40 backdrop-blur-sm rounded-3xl border-4 border-emerald-900/60 shadow-2xl">
