<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nông Trại Lipid - Hóa Học 12</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Fredoka -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    /* Custom Styling for Farm Theme */
    body {
      font-family: 'Fredoka', 'Inter', sans-serif;
      background: linear-gradient(180deg, #70d6ff 0%, #a0c4ff 35%, #b9fbc0 35%, #70e000 100%);
      min-height: 100vh;
      user-select: none;
      overflow-x: hidden;
    }

    /* Mây trôi animation */
    @keyframes moveClouds {
      0% { transform: translateX(-150px); }
      100% { transform: translateX(calc(100vw + 150px)); }
    }
    .cloud {
      position: absolute;
      animation: moveClouds linear infinite;
      opacity: 0.85;
      pointer-events: none;
    }

    /* Hiệu ứng nảy cho rau củ */
    @keyframes cropBounce {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-8px) scale(1.05); }
    }
    .crop-idle {
      animation: cropBounce 3s ease-in-out infinite;
    }
    .crop-idle:hover {
      transform: scale(1.15) rotate(3deg);
      filter: drop-shadow(0 8px 12px rgba(0,0,0,0.25));
    }

    /* Đất nông trại Texture */
    .soil-plot {
      background: #6d4c41;
      background-image: radial-gradient(#8d6e63 15%, transparent 16%), radial-gradient(#5d4037 15%, transparent 16%);
      background-size: 16px 16px;
      background-position: 0 0, 8px 8px;
      box-shadow: inset 0 4px 6px rgba(0,0,0,0.4), 0 6px 0 #3e2723;
    }

    .soil-plot-harvested {
      background: #4e342e;
      box-shadow: inset 0 6px 8px rgba(0,0,0,0.6);
      opacity: 0.9;
    }

    /* Bảng gỗ Wooden Panel */
    .wood-panel {
      background: #d7ccc8;
      background-image: linear-gradient(0deg, #d7ccc8 0%, #efebe9 100%);
      border: 6px solid #5d4037;
      box-shadow: 0 12px 24px rgba(0,0,0,0.35), inset 0 2px 4px rgba(255,255,255,0.8);
    }

    /* Nút chọn đáp án */
    .option-btn {
      transition: all 0.2s ease;
      box-shadow: 0 4px 0 #b0bec5;
    }
    .option-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 0 #90a4ae;
    }
    .option-btn:active:not(:disabled) {
      transform: translateY(2px);
      box-shadow: 0 2px 0 #90a4ae;
    }

    /* Confetti Canvas */
    #confettiCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 100;
    }

    /* Floating Score Text */
    @keyframes floatUp {
      0% { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(-60px) scale(1.3); }
    }
    .floating-score {
      position: absolute;
      animation: floatUp 1.2s ease-out forwards;
      font-weight: bold;
      color: #ffd700;
      text-shadow: 2px 2px 0 #000, -1px -1px 0 #000;
      pointer-events: none;
      z-index: 50;
    }
  </style>
</head>
<body class="flex flex-col min-h-screen relative overflow-x-hidden">

