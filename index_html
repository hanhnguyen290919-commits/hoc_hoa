  <!-- Header / Top Dashboard -->
  <header class="w-full max-w-6xl mx-auto px-4 pt-4 pb-2 z-10">
    <div class="wood-panel rounded-2xl p-3 md:p-4 flex flex-col md:flex-row items-center justify-between gap-3 text-amber-950">
      
      <!-- Game Title -->
      <div class="flex items-center gap-3">
        <div class="bg-amber-600 text-white p-2.5 rounded-xl border-2 border-amber-900 shadow">
          <span class="text-2xl md:text-3xl">🌾</span>
        </div>
        <div>
          <h1 class="text-xl md:text-2xl font-bold tracking-wide text-amber-900 drop-shadow">NÔNG TRẠI LIPID</h1>
